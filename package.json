{
  "name": "workspace",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test": "node --test --experimental-strip-types artifacts/api-server/src/lib/dates.test.ts artifacts/api-server/src/lib/finance.test.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
