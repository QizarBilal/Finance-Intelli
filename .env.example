# Runtime security (generate a unique value of at least 32 characters)
SESSION_SECRET=replace-with-a-cryptographically-random-secret
ALLOWED_ORIGINS=https://your-project.vercel.app

# MongoDB Atlas target. Never commit the real URI.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/finance_intelli?retryWrites=true&w=majority
MONGODB_DATABASE=finance_intelli

# Signup approval email (Resend; verify your sending domain first)
RESEND_API_KEY=re_replace-with-resend-api-key
RESEND_FROM_EMAIL=Finance Intelli <accounts@your-verified-domain.example>
APP_URL=https://finance-intelli.vercel.app

# Optional browser push delivery. Generate one permanent VAPID key pair and store it only in server environment settings.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push-contact@your-domain.example
