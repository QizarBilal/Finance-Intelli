# Runtime security (generate a unique value of at least 32 characters)
SESSION_SECRET=replace-with-a-cryptographically-random-secret
ALLOWED_ORIGINS=https://your-project.vercel.app

# MongoDB Atlas target. Never commit the real URI.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/finance_intelli?retryWrites=true&w=majority
MONGODB_DATABASE=finance_intelli
